@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<div class="admin-container">
    <nav class="admin-nav glass-nav">
        <div class="nav-brand">
            <span class="brand-icon">☕</span>
            <span class="brand-text">لومن | مدیریت</span>
        </div>
        <div class="nav-links">
            <NavLink href="/admin/dashboard" class="nav-link" Match="NavLinkMatch.Prefix">
                <span>📊</span> داشبورد
            </NavLink>
            <NavLink href="/admin/products" class="nav-link">
                <span>🍽️</span> محصولات
            </NavLink>
            <NavLink href="/admin/categories" class="nav-link">
                <span>📂</span> دسته‌بندی‌ها
            </NavLink>
            <button class="nav-link logout-btn" @onclick="Logout">
                <span>🚪</span> خروج
            </button>
        </div>
    </nav>

    <div class="admin-content">
        @Body
    </div>
</div>

@code {
    private void Logout()
    {
        NavigationManager.NavigateTo("/admin/login");
    }
}