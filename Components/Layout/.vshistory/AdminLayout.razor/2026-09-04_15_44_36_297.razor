@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

@using MudBlazor
@using Microsoft.JSInterop

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudRTLProvider RightToLeft="true">
    <div style="display: flex; min-height: 100vh;">
        <!-- Sidebar -->
        <div style="width: 250px; background: rgba(0,0,0,0.5); padding: 20px; color: #fff; min-height: 100vh; position: fixed; top: 0; right: 0; bottom: 0; overflow-y: auto;">
            <h3 style="color: #FFD700; margin-bottom: 30px;">☕ پنل قهوه</h3>
            <hr style="border-color: rgba(255,215,0,0.2); margin-bottom: 20px;" />

            <div style="display: flex; flex-direction: column; gap: 8px;">
                <!-- Use standard HTML links for navigation -->
                <a href="/admin/products"
                   style="color: #FFD700; text-decoration: none; padding: 12px 16px; border-radius: 8px; display: block; transition: all 0.3s ease;"
                   onmouseover="this.style.background='rgba(255,215,0,0.1)'"
                   onmouseout="this.style.background='transparent'">
                    📦 محصولات
                </a>
                <a href="/admin/categories"
                   style="color: rgba(255,255,255,0.6); text-decoration: none; padding: 12px 16px; border-radius: 8px; display: block; transition: all 0.3s ease;"
                   onmouseover="this.style.background='rgba(255,215,0,0.1)'; this.style.color='#FFD700'"
                   onmouseout="this.style.background='transparent'; this.style.color='rgba(255,255,255,0.6)'">
                    📂 دسته‌بندی‌ها
                </a>
                <a href="/admin/dashboard"
                   style="color: rgba(255,255,255,0.6); text-decoration: none; padding: 12px 16px; border-radius: 8px; display: block; transition: all 0.3s ease;"
                   onmouseover="this.style.background='rgba(255,215,0,0.1)'; this.style.color='#FFD700'"
                   onmouseout="this.style.background='transparent'; this.style.color='rgba(255,255,255,0.6)'">
                    📊 داشبورد
                </a>
            </div>
        </div>

        <!-- Main Content -->
        <div style="flex: 1; padding: 30px; margin-right: 250px; background: linear-gradient(135deg, #0a0a0a, #1a1a1a); min-height: 100vh;">
            @Body
        </div>
    </div>
</MudRTLProvider>

<style>
    /* Active link style */
    .nav-link-active {
        background: rgba(255, 215, 0, 0.1) !important;
        color: #FFD700 !important;
    }
</style>

@code {
    // You can add code here if needed
    protected override void OnInitialized()
    {
        // No interactivity needed here
    }
}