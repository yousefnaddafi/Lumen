@page "/admin/login"
@inject NavigationManager NavigationManager

<div class="admin-login-container">
    <div class="glass-card login-card">
        <div class="login-header">
            <h1>☕ لومن | پنل مدیریت</h1>
            <p>به پنل مدیریت منوی کافه لومن خوش آمدید</p>
        </div>

        <form @onsubmit="HandleLogin" @formname="loginForm">
            <div class="form-group">
                <label>نام کاربری</label>
                <input @bind="username" @bind:event="oninput" class="glass-input" placeholder="نام کاربری خود را وارد کنید" />
            </div>

            <div class="form-group">
                <label>رمز عبور</label>
                <input @bind="password" @bind:event="oninput" type="password" class="glass-input" placeholder="رمز عبور خود را وارد کنید" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-message">@errorMessage</div>
            }

            <button type="submit" class="btn-glass-primary">ورود به پنل مدیریت</button>
        </form>
    </div>
</div>

@code {
    private string username = "";
    private string password = "";
    private string errorMessage = "";

    private void HandleLogin()
    {
        if (username == "admin" && password == "LumenCafe2026")
        {
            NavigationManager.NavigateTo("/admin/products");
        }
        else
        {
            errorMessage = "نام کاربری یا رمز عبور اشتباه است";
        }
    }
}