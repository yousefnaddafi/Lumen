@page "/admin/login"
@rendermode InteractiveServer
@using MudBlazor
@inject NavigationManager NavigationManager

<div class="admin-login-container">
    <div class="glass-card login-card">
        <div class="login-header">
            <h1>☕ لومن | پنل مدیریت</h1>
            <p>به پنل مدیریت منوی کافه لومن خوش آمدید</p>
        </div>

        <EditForm Model="@loginModel" OnValidSubmit="@HandleLogin" FormName="loginForm">
            <div class="form-group">
                <label>نام کاربری</label>
                <input @bind="loginModel.Username"
                       type="text"
                       class="glass-input"
                       placeholder="نام کاربری خود را وارد کنید"
                       style="width: 100%; padding: 12px 16px; border-radius: 12px; border: 2px solid rgba(255,215,0,0.12); background: rgba(255,255,255,0.05); color: #fff; font-size: 15px; outline: none; transition: all 0.3s ease;" />
            </div>

            <div class="form-group">
                <label>رمز عبور</label>
                <input @bind="loginModel.Password"
                       type="password"
                       class="glass-input"
                       placeholder="رمز عبور خود را وارد کنید"
                       style="width: 100%; padding: 12px 16px; border-radius: 12px; border: 2px solid rgba(255,215,0,0.12); background: rgba(255,255,255,0.05); color: #fff; font-size: 15px; outline: none; transition: all 0.3s ease;" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-message">@errorMessage</div>
            }

            <button type="submit" class="btn-glass-primary">ورود به پنل مدیریت</button>
        </EditForm>
    </div>
</div>


@code {
    private LoginModel loginModel = new();
    private string errorMessage = "";

    private async Task HandleLogin()
    {
        await InvokeAsync(StateHasChanged);
        if (loginModel.Username == "admin" && loginModel.Password == "LumenCafe2026")
        {
            NavigationManager.NavigateTo("/admin/products");
        }
        else
        {
            errorMessage = "نام کاربری یا رمز عبور اشتباه است";
            loginModel.Password = ""; // Clear password for security
        }
    }

    public class LoginModel
    {
        public string? Username { get; set; }
        public string? Password { get; set; }
    }
}