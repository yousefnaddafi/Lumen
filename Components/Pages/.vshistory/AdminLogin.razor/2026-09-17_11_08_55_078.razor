    }

        .btn-glass-primary:hover {
            transform: translateY(-2px) !important;
            box-shadow: 0 8px 30px rgba(255, 215, 0, 0.3) !important;
        }

    /* Fix MudBlazor input styles */
    .mud-input {
        color: #fff !important;
    }

    .mud-input-root {
