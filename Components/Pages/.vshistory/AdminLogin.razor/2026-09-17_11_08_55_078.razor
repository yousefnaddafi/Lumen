    }

        .mud-input-root input {
            color: #fff !important;
        }

            .mud-input-root input::placeholder {
                color: rgba(255, 255, 255, 0.3) !important;
            }
</style>
@code {
    private string? username = string.Empty;
    private string? password = string.Empty;
    private string errorMessage = "";
    private bool isBusy;

    private async Task HandleLogin()
    {
        if (isBusy) return;
        isBusy = true;
        errorMessage = "";

        try
        {
            if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
            {
                errorMessage = "نام کاربری و رمز عبور را وارد کنید";
                return;
            }

            // Identity uses UserName or Email. We pass UserName.
            var result = await SignInManager.PasswordSignInAsync(
                userName: username!,
                password: password!,
                isPersistent: true,
                lockoutOnFailure: true);

            if (result.Succeeded)
            {
                NavigationManager.NavigateTo("/admin/products", forceLoad: false);
                return;
            }

            if (result.IsLockedOut)
                errorMessage = "حساب کاربری موقتاً قفل شده است. لطفاً بعداً تلاش کنید.";
            else if (result.IsNotAllowed)
                errorMessage = "ورود برای این حساب مجاز نیست.";
            else
                errorMessage = "نام کاربری یا رمز عبور اشتباه است";

            password = "";
        }
        catch (Exception ex)
        {
            errorMessage = "خطای غیرمنتظره در ورود";
            Console.WriteLine(ex);
        }
        finally
        {
            isBusy = false;
        }
    }
}
