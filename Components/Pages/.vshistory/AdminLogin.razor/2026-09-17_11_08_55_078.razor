        .form-group label {
            color: rgba(255, 255, 255, 0.6);
            font-size: 14px;
            display: block;
            margin-bottom: 6px;
            font-weight: 500;
        }

    .glass-input .mud-input-root {
        background: rgba(255, 255, 255, 0.05) !important;
        border: 2px solid rgba(255, 215, 0, 0.12) !important;
        border-radius: 12px !important;
        color: #fff !important;
        padding: 12px 16px !important;
    }

        .glass-input .mud-input-root:focus {
            border-color: #FFD700 !important;
            box-shadow: 0 0 20px rgba(255, 215, 0, 0.05) !important;
        }

        .glass-input .mud-input-root input {
            color: #fff !important;
        }

            .glass-input .mud-input-root input::placeholder {
                color: rgba(255, 255, 255, 0.3) !important;
            }

    .error-message {
        color: #f44336;
        background: rgba(244, 67, 54, 0.1);
        padding: 10px 16px;
        border-radius: 12px;
        margin-bottom: 16px;
        font-size: 14px;
        text-align: center;
        border: 1px solid rgba(244, 67, 54, 0.2);
    }

    .btn-glass-primary {
        background: linear-gradient(135deg, #FFD700 0%, #FFB800 100%) !important;
        color: #1a1a1a !important;
        border: none !important;
        border-radius: 12px !important;
        padding: 14px !important;
        font-weight: 700 !important;
        cursor: pointer !important;
        transition: all 0.3s ease !important;
        box-shadow: 0 4px 20px rgba(255, 215, 0, 0.2) !important;
        font-family: 'Vazirmatn', sans-serif !important;
