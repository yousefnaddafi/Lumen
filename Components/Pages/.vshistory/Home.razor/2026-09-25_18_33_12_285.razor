@page "/"
@using Lumen.Components.Pages.Dialogs
@using Lumen.Models
@using Lumen.Services.ProductCatgoryServices
@using Lumen.Services.ProductServices
@inject IProductService ProductService;
@inject IProductCategoryService CategoryService;
@inject IJSRuntime JS
<!DOCTYPE html>
<html dir="rtl" lang="fa">
<head>
    <link rel="stylesheet" href="css/font/all.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>منوی قهوه لومِن</title>
    <style>
        /* Global Styles */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        @@font-face {
            font-family: 'Sahel';
            src: url('/fonts/Sahel.ttf') format('truetype');
        }

        div {
            position: relative;
        }

        container {
            position: relative;
            width: 80%; /* Adjust as needed */
            margin: auto;
            display: inline-block;
        }

        .background-image {
            width: 100%;
            display: block;
            border-radius: 20px;
            margin-bottom: 40%;
            
            /* aspect-ratio: 5/3; */
            aspect-ratio: 20/16;
        }

        .overlay-box {
            z-index: 100;
            position: absolute;
            width: 80%;
            height: 150px;
            background-color: rgba(255, 255, 255, 0.9); /* Slightly darker opacity */
            top: -10%;
            left: 50%;
            transform: translateX(-50%);
            text-align: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 10px;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2);
            border-radius: 10px;
            border: 2px solid red;
            background-color: rgba(255, 0, 0, 0.5);
        }

        .item-title {
            font-size: 22px;
            font-weight: bold;
            color: #333;
        }

        .item-description {
            font-size: 16px;
            color: #555;
            margin-top: 5px;
        }

        .item-price {
            font-size: 18px;
            font-weight: bold;
            color: #c0392b;
            margin-top: 8px;
        }




        body {
            font-family: Arial, sans-serif;
            font-family: Sahel;
            background-color: #f5f5f5;
            color: #4a4a4a;
            line-height: 1.6;
            scroll-behavior: smooth;
        }

        a {
            text-decoration: none;
            color: inherit;
        }
        /* Header - Video Background Section */
        header {
    position: relative;
    height: 70vh;
    width: 100%;
    overflow: hidden;
    isolation: isolate; /* creates a clean stacking context just for the header */
}

header video {
    position: absolute;
    inset: 0;               /* top/right/bottom/left: 0 */
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;             /* not -1 */
    pointer-events: none;
}

.hero-overlay {
    position: relative;
    z-index: 1;             /* above the video */
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: rgba(0, 0, 0, 0.3);
    padding: 20px;
}

            .hero-overlay img.logo {
                width: 150px;
                margin-bottom: 20px;
            }

            .hero-overlay h1 {
                font-size: 3em;
                color: #fff;
                font-weight: bold;
                margin-bottom: 10px;
            }

            .hero-overlay p.tagline {
                font-size: 1.2em;
                color: #f5f5f5;
            }

        /* Category Slider */
        .category-slider {
            overflow-x: auto;
            white-space: nowrap;
            background: #fafafa;
            padding: 10px 0;
            border-bottom: 1px solid #ddd;
            transition: all 0.3s ease;
            scroll-behavior: smooth;
            display: flex;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1) !important;
        }

            .category-slider.sticky {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                z-index: 1000;
                box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            }

        .category-container {
            display: flex;
            flex-wrap: nowrap;
            margin: 0 20px;
            gap: 10px;
        }

        .insta-button {
            border: black;
            border-radius: 10px;
            padding: 10px 20px;
            font-size: 1em;
            font-weight: 800;
            cursor: pointer;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2);
            flex: 0 0 auto;
            transition: background-color 0.3s, transform 0.3s, border 0.3s;
            background-color: #FFBE98;
        }

        .category-tag {
            background-color: white;
            border: black;
            border-radius: 10px;
            padding: 10px 20px;
            font-size: 1em;
            font-weight: 800;
            cursor: pointer;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2);
            flex: 0 0 auto;
            transition: background-color 0.3s, transform 0.3s, border 0.3s;
        }

            .category-tag.active {
                transform: scale(1.05);
                background-color: #FFBE98;
            }

        @@media (max-width: 600px) {
            .category-tag {
                min-width: 120px;
            }
        }


        /* Menu Sections */
        .menu-section {
            /* padding: 40px 20px; */
            background-color: #fafafa;
        }

            .menu-section h2 {
                text-align: center;
                font-size: 2.5em;
                margin-bottom: 30px;
                color: #a79c94;
            }
        /* Instead of a grid, we now use a vertical list */
        .menu-grid {
            display: flex;
            flex-direction: column;
            gap: 10px;
            max-width: 1200px;
            margin: 0 auto;
        }
        /* New layout for each menu item */
        .menu-card {
            display: flex;
            align-items: center;
            padding: 10px 0;
            margin-bottom: 10px;
            background: transparent;
            border: none;
            box-shadow: none;
            background-size: cover;
            background-position: center;
            margin-bottom: 90px;
        }

            .menu-card img {
                border-radius: 20px;
                width: 80%;
                height: auto;
                margin-right: 10%;
                aspect-ratio: 20/16;
            }

        .menu-details {
            z-index: 100;
            position: absolute;
            width: 60%;
            background-color: rgba(255, 255, 255, 0.9); /* Slightly darker opacity */
            bottom: -40%;
            left: 50%;
            transform: translateX(-50%);
            /* text-align: center; */
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 10px;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2);
            border-radius: 10px;
            background-color: white;
            aspect-ratio: 7/3;
            /* flex: 1;
                                            direction: rtl;
                                            text-align: right;
                                            img {

                                            } */
        }

        .menu-item-title {
            margin-left: auto;
            font-size: 16px;
            color: black;
            margin-bottom: 8px;
            font-weight: 800;
        }

        .menu-item-desc {
            margin-left: auto;
            color: #333;
            font-size: 11px;
            margin-bottom: 5px;
            font-weight: 100;
            float: right;
        }

        .menu-item-price {
            font-size: 14px;
            margin-left: auto;
            font-weight: bold;
            color: #333;
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 20px 0;
            background-color: #fafafa;
            color: #777;
            font-size: 0.9em;
        }

        /* Scroll-to-Top Button (icon only) */
        #scrollToTop {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background-color: #a79c94;
            color: #fff;
            border: none;
            padding: 10px;
            border-radius: 50%;
            cursor: pointer;
            z-index: 1001;
            display: none;
            font-size: 1.5em;
            line-height: 1;
        }
    </style>

</head>
<body>
    <!-- Hero Video Section -->
    <HeroHeader/>
    <!-- Category Slider -->
    <div class="category-slider" style="padding-top:24px;padding-bottom:24px;box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2);" id="categorySlider">
        <div class="category-container">
            @foreach(var cat in Categories)
            {
                <div class="category-tag" data-target="@cat.ProductCategoryId">@cat.Title </div>
            }
         
        </div>
    </div>

    <!-- Menu Sections for each Category -->
    <div id="menu" style="background-image: url('img\sement.jpg');">

        @foreach(var cat in Categories)
        {
            <section id="@cat.ProductCategoryId" class="menu-section">
                <div class="menu-grid">
                    @foreach(var product in Products.Where(z=>z.ProductCategoryId == cat.ProductCategoryId))
                    {
                        <div class="menu-card  item-wrapper container">
                            <div class="menu-details">
                                <div class="menu-item-title">@product.Title</div>
                                <div class="menu-item-desc">@product.Description</div>
                                <div class="menu-item-price">تجاری : @product.EcoPrice تومان</div>
                                @if(product.BusinessPrice != null)
                                {
                                    <div class="menu-item-price">تخصصی : @product.BusinessPrice تومان</div>
                                }
                            </div>
                            @if (string.IsNullOrEmpty(product.Image))
                            {
                                <img src="img/coffee.jpg" alt="@product.Title">
                            }
                            else
                            {
                                <img src="@product.Image" alt="@product.Title">
                            }
                            
                        </div>
                    }
                   
                </div>
            </section>
        }

      

    </div>
    <!-- Footer -->
    <footer style="background-color:#FFBE98;color:white">
        <div style="text-align:right">
            <p style="float:right;padding-right:10px;width:100%"><img src="img/location.png" style="width:20px"> آدرس : بلوار فردوس شرق, خیابان ابراهیمی, کوچه پنجم </p>
            <a href="tel:+989126023218" style="float:right;padding:10px;width:100%">
                <img src="img/phonecall.png" style="width:20px"> 09126023218
            </a>
            <br />
            <p style="float:right;padding:10px;width:100%"><img src="img/clock.png" style="width:20px"> 6 صبح الی 24 </p>
        </div>
        <br />
        <div style="text-align:left">
            &copy; ۲۰۲۵ قهوه لومِن. کلیه حقوق محفوظ است.
        </div>

    </footer>

    <!-- Scroll-to-Top Button (up arrow icon only) -->
    <button id="scrollToTop" style="background-color:#FFBE98"><img src="img/up.png" style="width:25px"></button>
    @code {
        public List<ProductCategory> Categories { get; set; } = new();
        public List<Product> Products { get; set; } = new();
        private bool _dataLoaded;
        protected override async Task OnAfterRenderAsync(bool firstRender)
        {
            // Run after the dynamic DOM (categories/products) has been rendered
            _dataLoaded = true;

            // Defensive: wait until the global exists (max ~1s)
            for (int i = 0; i < 20; i++)
            {
                var exists = await JS.InvokeAsync<bool>(
                "eval", "typeof window.lumenMenu !== 'undefined'");
                if (exists) break;
                await Task.Delay(50);
            }

            await JS.InvokeVoidAsync("lumenMenu.init");
        }

        protected override async Task OnInitializedAsync()
        {
            Products = ProductService.GetAll(null, true);
            Categories = CategoryService.GetAll(0, 0, null);
        }
    }
    <!-- JavaScript for Sticky Slider, Active Tag Highlighting & Auto-Scroll, and Scroll-to-Top -->
