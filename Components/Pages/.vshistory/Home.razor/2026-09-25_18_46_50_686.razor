@page "/"
@using Lumen.Components.Pages.Dialogs
@using Lumen.Models
@using Lumen.Services.ProductCatgoryServices
@using Lumen.Services.ProductServices
@inject IProductService ProductService;
@inject IProductCategoryService CategoryService;
@inject IJSRuntime JS
<!DOCTYPE html>
<html dir="rtl" lang="fa">
<head>
    <link rel="stylesheet" href="css/font/all.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>منوی قهوه لومِن</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        @@font -face {
            font-family: 'Sahel';
            src: url('/fonts/Sahel.ttf') format('truetype');
        }

        body {
            font-family: 'Sahel', Arial, sans-serif;
            background: linear-gradient(145deg, #f7f3ef 0%, #e8e0d8 100%);
            min-height: 100vh;
            color: #2e2e2e;
            line-height: 1.6;
            scroll-behavior: smooth;
            padding: 0 0 20px 0;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* ---------- HERO VIDEO ---------- */
        header {
            position: relative;
            height: 70vh;
            width: 100%;
            overflow: hidden;
            isolation: isolate;
            border-radius: 0 0 48px 48px;
            margin-bottom: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
        }

            header video {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
                z-index: 0;
                pointer-events: none;
                filter: brightness(0.75) saturate(1.2);
            }

        .hero-overlay {
            position: relative;
            z-index: 2;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            background: radial-gradient(circle at 20% 30%, rgba(255, 190, 152, 0.3), rgba(0, 0, 0, 0.2));
            backdrop-filter: blur(3px);
            padding: 20px;
        }

            .hero-overlay img.logo {
                width: 150px;
                margin-bottom: 20px;
                filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.3));
                border-radius: 30px;
            }

            .hero-overlay h1 {
                font-size: 3.2em;
                color: #fff;
                font-weight: 800;
                margin-bottom: 8px;
                text-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
                letter-spacing: 1px;
                background: linear-gradient(135deg, #fff8f0, #ffd9c4);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }

            .hero-overlay p.tagline {
                font-size: 1.3em;
                color: #f5f5f5;
                text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
                font-weight: 300;
            }

        /* ---------- CATEGORY SLIDER ---------- */
        .category-slider {
            overflow-x: auto;
            white-space: nowrap;
            background: rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(16px) saturate(180%);
            -webkit-backdrop-filter: blur(16px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.6);
            padding: 18px 0;
            border-radius: 60px;
            margin: 0 20px 30px 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08), inset 0 0 0 1px rgba(255, 255, 255, 0.6);
            transition: all 0.3s ease;
            scroll-behavior: smooth;
            display: flex;
        }

            .category-slider.sticky {
                position: fixed;
                top: 16px;
                left: 20px;
                right: 20px;
                width: auto;
                z-index: 1000;
                box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
                background: rgba(255, 255, 255, 0.4);
                backdrop-filter: blur(20px);
                border: 1px solid rgba(255, 255, 255, 0.8);
            }

        .category-container {
            display: flex;
            flex-wrap: nowrap;
            gap: 12px;
            padding: 0 20px;
        }

        .category-tag {
            background: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.9);
            border-radius: 40px;
            padding: 12px 28px;
            font-size: 1rem;
            font-weight: 700;
            color: #3d2b1f;
            cursor: pointer;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.05), inset 0 0 0 1px rgba(255, 255, 255, 0.9);
            flex: 0 0 auto;
            transition: all 0.25s ease;
        }

            .category-tag.active {
                transform: scale(1.05);
                background: linear-gradient(135deg, #ffbe98, #ff9f6e);
                color: #1e1e1e;
                border-color: #fff;
                box-shadow: 0 12px 24px rgba(255, 150, 100, 0.4), 0 0 30px rgba(255, 190, 152, 0.5);
                font-weight: 800;
            }

        .insta-button {
            border: 1px solid rgba(255, 255, 255, 0.8);
            border-radius: 40px;
            padding: 12px 28px;
            font-size: 1rem;
            font-weight: 800;
            cursor: pointer;
            background: rgba(255, 190, 152, 0.7);
            backdrop-filter: blur(8px);
            box-shadow: 0 8px 20px rgba(255, 150, 100, 0.3);
            flex: 0 0 auto;
            transition: all 0.3s ease;
            color: #2e1e12;
        }

        /* ---------- MENU SECTIONS ---------- */
        #menu {
            background-image: url('img/sement.jpg');
            background-size: cover;
            background-attachment: fixed;
            background-position: center;
            padding: 20px 0 40px 0;
            margin: 0 16px;
            border-radius: 64px;
            backdrop-filter: blur(4px);
            position: relative;
            box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.3), 0 30px 50px rgba(0, 0, 0, 0.1);
        }

        .menu-section {
            background: transparent;
            padding: 30px 16px;
        }

            .menu-section h2 {
                text-align: center;
                font-size: 2.8em;
                margin-bottom: 36px;
                color: #ffffff;
                text-shadow: 0 8px 32px rgba(0, 0, 0, 0.6), 0 0 20px rgba(255, 190, 152, 0.4);
                font-weight: 800;
                letter-spacing: 2px;
            }

        .menu-grid {
            display: flex;
            flex-direction: column;
            gap: 16px;
            max-width: 1000px;
            margin: 0 auto;
        }

        /* ---------- MENU CARD (FIXED LAYOUT) ---------- */
        /* The card is a column: image on top, details floating at the bottom overlapping slightly */
        .menu-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            position: relative;
            margin-bottom: 80px; /* space for the floating details box */
            border-radius: 48px;
            transition: transform 0.3s ease;
        }

            .menu-card:hover {
                transform: translateY(-6px);
            }

            .menu-card img {
                border-radius: 48px;
                width: 85%;
                height: auto;
                aspect-ratio: 20/16;
                object-fit: cover;
                box-shadow: 0 30px 50px rgba(0, 0, 0, 0.25), 0 0 0 2px rgba(255, 255, 255, 0.4);
                border: 1px solid rgba(255, 255, 255, 0.6);
                transition: all 0.4s ease;
                filter: brightness(1.02) saturate(1.1);
                z-index: 1;
            }

        /* Details box: positioned absolutely at the bottom of the card,
                   but only overlaps a small portion of the image, keeping it visible */
        .menu-details {
            position: absolute;
            bottom: -50px; /* pushes it down, overlapping the bottom edge of the image */
            left: 50%;
            transform: translateX(-50%);
            width: 75%;
            background: rgba(255, 255, 255, 0.55);
            backdrop-filter: blur(20px) saturate(200%);
            -webkit-backdrop-filter: blur(20px) saturate(200%);
            border-radius: 36px;
            border: 1px solid rgba(255, 255, 255, 0.9);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2), inset 0 0 0 1px rgba(255, 255, 255, 0.8), inset 0 0 30px rgba(255, 255, 255, 0.3);
            padding: 16px 20px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            z-index: 10;
            transition: all 0.3s ease;
        }

        .menu-card:hover .menu-details {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(24px) saturate(220%);
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.25), inset 0 0 0 1.5px rgba(255, 255, 255, 0.9);
        }

        .menu-item-title {
            font-size: 1.3rem;
            color: #1e1e1e;
            font-weight: 800;
            margin-bottom: 4px;
            text-shadow: 0 1px 4px rgba(255, 255, 255, 0.8);
        }

        .menu-item-desc {
            color: #3d3d3d;
            font-size: 0.85rem;
            font-weight: 400;
            margin-bottom: 6px;
            opacity: 0.9;
            text-shadow: 0 1px 2px rgba(255, 255, 255, 0.6);
            line-height: 1.4;
            max-width: 90%;
        }

        .menu-item-price {
            font-size: 1rem;
            font-weight: 700;
            color: #a33f1f;
            text-shadow: 0 1px 6px rgba(255, 255, 255, 0.9);
            background: rgba(255, 255, 255, 0.5);
            padding: 4px 14px;
            border-radius: 40px;
            backdrop-filter: blur(4px);
            border: 1px solid rgba(255, 255, 255, 0.6);
            margin-top: 4px;
        }

        /* ---------- FOOTER ---------- */
        footer {
            text-align: center;
            padding: 30px 20px;
            margin: 30px 20px 10px 20px;
            background: rgba(255, 190, 152, 0.35);
            backdrop-filter: blur(16px) saturate(180%);
            -webkit-backdrop-filter: blur(16px) saturate(180%);
            border-radius: 48px;
            border: 1px solid rgba(255, 255, 255, 0.7);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1), inset 0 0 0 1px rgba(255, 255, 255, 0.8);
            color: #2e1e12;
            font-weight: 500;
        }

            footer a {
                color: #2e1e12;
                font-weight: 600;
            }

            footer img {
                filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
                vertical-align: middle;
            }

        /* ---------- SCROLL TO TOP ---------- */
        #scrollToTop {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: rgba(255, 190, 152, 0.6);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.9);
            padding: 16px;
            border-radius: 50%;
            cursor: pointer;
            z-index: 1001;
            display: none;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2), inset 0 0 0 1px rgba(255, 255, 255, 0.8);
            transition: all 0.3s ease;
            width: 65px;
            height: 65px;
            align-items: center;
            justify-content: center;
        }

            #scrollToTop:hover {
                transform: scale(1.1);
                background: rgba(255, 160, 110, 0.8);
            }

        /* ---------- RESPONSIVE ---------- */
        @media (max-width: 700px) {
            .menu-details

        {
            width: 88%;
            padding: 12px 14px;
            bottom: -45px;
        }

        .menu-item-title {
            font-size: 1.05rem;
        }

        .menu-item-desc {
            font-size: 0.75rem;
        }

        .menu-item-price {
            font-size: 0.85rem;
            padding: 3px 10px;
        }

        .menu-card img {
            width: 95%;
        }

        .category-slider {
            margin: 0 8px 20px 8px;
            padding: 12px 0;
        }

        .category-tag {
            padding: 10px 18px;
            font-size: 0.85rem;
        }

        .hero-overlay h1 {
            font-size: 2.2em;
        }

        #menu {
            margin: 0 8px;
            border-radius: 40px;
        }

        .menu-card {
            margin-bottom: 70px;
        }

        }

        @media (max-width: 480px) {
            .menu-details

        {
            width: 92%;
            bottom: -40px;
            padding: 10px 12px;
        }

        .menu-item-desc {
            font-size: 0.7rem;
        }

        .menu-item-title {
            font-size: 0.95rem;
        }

        }
    </style>
</head>
<body>
    <!-- Hero Video Section -->
    <HeroHeader />

    <!-- Category Slider -->
    <div class="category-slider" id="categorySlider">
        <div class="category-container">
            @foreach (var cat in Categories)
            {
                <div class="category-tag" data-target="@cat.ProductCategoryId">@cat.Title</div>
            }
        </div>
    </div>

    <!-- Menu Sections -->
    <div id="menu">
        @foreach (var cat in Categories)
        {
            <section id="@cat.ProductCategoryId" class="menu-section">
                <div class="menu-grid">
                    @foreach (var product in Products.Where(z => z.ProductCategoryId == cat.ProductCategoryId))
                    {
                        <div class="menu-card">
                            <!-- Image displayed fully on top -->
                            @if (string.IsNullOrEmpty(product.Image))
                            {
                                <img src="img/coffee.jpg" alt="@product.Title">
                            }
                            else
                            {
                                <img src="@product.Image" alt="@product.Title">
                            }

                            <!-- Glass details box at the bottom, partially overlapping the image -->
                            <div class="menu-details">
                                <div class="menu-item-title">@product.Title</div>
                                <div class="menu-item-desc">@product.Description</div>
                                <div class="menu-item-price">تجاری : @product.EcoPrice تومان</div>
                                @if (product.BusinessPrice != null)
                                {
                                    <div class="menu-item-price">تخصصی : @product.BusinessPrice تومان</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
    </div>

    <!-- Footer -->
    <footer>
        <div style="text-align:right; display: flex; flex-direction: column; gap: 6px;">
            <p style="float:right; padding-right:10px; width:100%; display: flex; align-items: center; justify-content: flex-end; gap: 8px;">
                <img src="img/location.png" style="width:20px"> آدرس : بلوار فردوس شرق, خیابان ابراهیمی, کوچه پنجم
            </p>
            <a href="tel:+989126023218" style="float:right; padding:6px 10px; width:100%; display: flex; align-items: center; justify-content: flex-end; gap: 8px;">
                <img src="img/phonecall.png" style="width:20px"> 09126023218
            </a>
            <p style="float:right; padding:6px 10px; width:100%; display: flex; align-items: center; justify-content: flex-end; gap: 8px;">
                <img src="img/clock.png" style="width:20px"> 6 صبح الی 24
            </p>
        </div>
        <div style="text-align:left; margin-top: 16px; opacity: 0.85; font-size: 0.9em;">
            &copy; ۲۰۲۵ قهوه لومِن. کلیه حقوق محفوظ است.
        </div>
    </footer>

    <!-- Scroll-to-Top Button -->
    <button id="scrollToTop">
        <img src="img/up.png" style="width:25px; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));">
    </button>

    @code {
        public List<ProductCategory> Categories { get; set; } = new();
        public List<Product> Products { get; set; } = new();
        private bool _dataLoaded;

        protected override async Task OnAfterRenderAsync(bool firstRender)
        {
            _dataLoaded = true;
            for (int i = 0; i < 20; i++)
            {
                var exists = await JS.InvokeAsync<bool>("eval", "typeof window.lumenMenu !== 'undefined'");
                if (exists) break;
                await Task.Delay(50);
            }
            await JS.InvokeVoidAsync("lumenMenu.init");
        }

        protected override async Task OnInitializedAsync()
        {
            Products = ProductService.GetAll(null, true);
            Categories = CategoryService.GetAll(0, 0, null);
        }
    }
</body>
</html>