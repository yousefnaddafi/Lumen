@page "/"
@using Lumen.Components.Pages.Dialogs
@using Lumen.Models
@using Lumen.Services.ProductCatgoryServices
@using Lumen.Services.ProductServices
@inject IProductService ProductService;
@inject IProductCategoryService CategoryService;
@inject IJSRuntime JS
<!DOCTYPE html>
<html dir="rtl" lang="fa">
<head>
    <link rel="stylesheet" href="css/font/all.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>منوی قهوه لومِن</title>
    <style>
        /* ============================================================
                   THEME: YELLOW · BLACK · SILVER
                   ============================================================ */
        :root {
            --yellow: #FFD400; /* vibrant cafe yellow */
            --yellow-soft: #FFE566;
            --yellow-deep: #E6B800;
            --black: #111111;
            --black-soft: #1c1c1c;
            --silver: #C9CCD1;
            --silver-light: #F1F2F4;
            --silver-dark: #8D9096;
            --glass-bg: rgba(255, 255, 255, 0.28);
            --glass-bg-strong: rgba(255, 255, 255, 0.45);
            --glass-border: rgba(255, 255, 255, 0.65);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        @font -face {
            font-family: 'Sahel';
            src: url('/fonts/Sahel.ttf') format('truetype');
        }

        body {
            font-family: 'Sahel', Arial, sans-serif;
            background: radial-gradient(circle at 15% 10%, rgba(255, 212, 0, 0.12), transparent 45%), radial-gradient(circle at 85% 90%, rgba(201, 204, 209, 0.35), transparent 50%), linear-gradient(160deg, #f4f4f5 0%, #e2e3e6 100%);
            min-height: 100vh;
            color: var(--black);
            line-height: 1.6;
            scroll-behavior: smooth;
            padding: 0 0 20px 0;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* ---------- HERO VIDEO ---------- */
        header {
            position: relative;
            height: 70vh;
            width: 100%;
            overflow: hidden;
            isolation: isolate;
            border-radius: 0 0 48px 48px;
            margin-bottom: 20px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
            border-bottom: 3px solid var(--yellow);
        }

            header video {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
                z-index: 0;
                pointer-events: none;
                filter: brightness(0.65) saturate(1.1) contrast(1.05);
            }

        .hero-overlay {
            position: relative;
            z-index: 2;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            background: radial-gradient(circle at 50% 40%, rgba(255, 212, 0, 0.18), transparent 60%), linear-gradient(to bottom, rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.65));
            backdrop-filter: blur(2px);
            padding: 20px;
        }

            .hero-overlay img.logo {
                width: 150px;
                margin-bottom: 20px;
                filter: drop-shadow(0 8px 22px rgba(255, 212, 0, 0.45));
                border-radius: 30px;
            }

            .hero-overlay h1 {
                font-size: 3.2em;
                font-weight: 800;
                margin-bottom: 8px;
                letter-spacing: 1px;
                background: linear-gradient(135deg, #FFFFFF 0%, var(--yellow) 45%, var(--silver) 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
                text-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);
            }

            .hero-overlay p.tagline {
                font-size: 1.3em;
                color: var(--silver-light);
                text-shadow: 0 2px 12px rgba(0, 0, 0, 0.7);
                font-weight: 300;
                letter-spacing: 0.5px;
            }

        /* ---------- CATEGORY SLIDER (silver glass) ---------- */
        .category-slider {
            overflow-x: auto;
            white-space: nowrap;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.5), rgba(201, 204, 209, 0.35));
            backdrop-filter: blur(18px) saturate(180%);
            -webkit-backdrop-filter: blur(18px) saturate(180%);
            border: 1px solid var(--glass-border);
            padding: 18px 0;
            border-radius: 60px;
            margin: 0 20px 30px 20px;
            box-shadow: 0 10px 34px rgba(0, 0, 0, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.9), inset 0 -1px 0 rgba(141, 144, 150, 0.25);
            transition: all 0.3s ease;
            scroll-behavior: smooth;
            display: flex;
        }

            .category-slider.sticky {
                position: fixed;
                top: 16px;
                left: 20px;
                right: 20px;
                width: auto;
                z-index: 1000;
                box-shadow: 0 14px 44px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.95);
                background: linear-gradient(135deg, rgba(255, 255, 255, 0.72), rgba(201, 204, 209, 0.55));
                backdrop-filter: blur(22px);
                border: 1px solid rgba(255, 255, 255, 0.9);
            }

        .category-container {
            display: flex;
            flex-wrap: nowrap;
            gap: 12px;
            padding: 0 20px;
        }

        .category-tag {
            background: linear-gradient(145deg, rgba(255, 255, 255, 0.75), rgba(201, 204, 209, 0.5));
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.95);
            border-radius: 40px;
            padding: 12px 28px;
            font-size: 1rem;
            font-weight: 700;
            color: var(--black);
            cursor: pointer;
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08), inset 0 1px 0 rgba(255, 255, 255, 1);
            flex: 0 0 auto;
            transition: all 0.25s ease;
            letter-spacing: 0.3px;
        }

            .category-tag:hover {
                background: linear-gradient(145deg, rgba(255, 255, 255, 0.95), rgba(201, 204, 209, 0.65));
                transform: translateY(-2px);
            }

            .category-tag.active {
                transform: scale(1.05);
                background: linear-gradient(135deg, var(--yellow) 0%, var(--yellow-deep) 100%);
                color: var(--black);
                border-color: var(--black);
                font-weight: 800;
                box-shadow: 0 10px 26px rgba(255, 212, 0, 0.55), 0 0 0 2px rgba(17, 17, 17, 0.85), inset 0 1px 0 rgba(255, 255, 255, 0.6);
            }

        .insta-button {
            border: 1px solid var(--black);
            border-radius: 40px;
            padding: 12px 28px;
            font-size: 1rem;
            font-weight: 800;
            cursor: pointer;
            background: linear-gradient(135deg, var(--yellow), var(--yellow-deep));
            backdrop-filter: blur(8px);
            box-shadow: 0 8px 20px rgba(255, 212, 0, 0.4);
            flex: 0 0 auto;
            transition: all 0.3s ease;
            color: var(--black);
        }

        /* ---------- MENU SECTIONS ---------- */
        #menu {
            background-image: url('img/sement.jpg');
            background-size: cover;
            background-attachment: fixed;
            background-position: center;
            background-color: #dcdde0;
            padding: 20px 0 40px 0;
            margin: 0 16px;
            border-radius: 64px;
            position: relative;
            box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.4), 0 30px 60px rgba(0, 0, 0, 0.18);
        }

            /* subtle silver/yellow veil over the background image */
            #menu::before {
                content: '';
                position: absolute;
                inset: 0;
                border-radius: 64px;
                background: linear-gradient(160deg, rgba(17, 17, 17, 0.35) 0%, rgba(201, 204, 209, 0.15) 45%, rgba(255, 212, 0, 0.10) 100%);
                pointer-events: none;
                z-index: 0;
            }

        .menu-section {
            background: transparent;
            padding: 30px 16px;
            position: relative;
            z-index: 1;
        }

            .menu-section h2 {
                text-align: center;
                font-size: 2.6em;
                margin-bottom: 36px;
                font-weight: 800;
                letter-spacing: 2px;
                background: linear-gradient(135deg, #FFFFFF 0%, var(--yellow) 55%, var(--silver) 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
                text-shadow: 0 6px 28px rgba(0, 0, 0, 0.7);
            }

        .menu-grid {
            display: flex;
            flex-direction: column;
            gap: 16px;
            max-width: 1000px;
            margin: 0 auto;
        }

        /* ---------- MENU CARD ---------- */
        .menu-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            position: relative;
            margin-bottom: 80px;
            border-radius: 48px;
            transition: transform 0.3s ease;
        }

            .menu-card:hover {
                transform: translateY(-6px);
            }

            .menu-card img {
                border-radius: 48px;
                width: 85%;
                height: auto;
                aspect-ratio: 20/16;
                object-fit: cover;
                box-shadow: 0 30px 55px rgba(0, 0, 0, 0.35), 0 0 0 2px var(--silver), 0 0 0 4px var(--yellow);
                border: 1px solid rgba(255, 255, 255, 0.7);
                transition: all 0.4s ease;
                filter: brightness(1.02) saturate(1.08) contrast(1.03);
                z-index: 1;
            }

            .menu-card:hover img {
                box-shadow: 0 36px 65px rgba(0, 0, 0, 0.4), 0 0 0 2px var(--silver-light), 0 0 0 4px var(--yellow), 0 0 30px rgba(255, 212, 0, 0.35);
            }

        /* Glass details box – silver tinted */
        .menu-details {
            position: absolute;
            bottom: -50px;
            left: 50%;
            transform: translateX(-50%);
            width: 75%;
            background: linear-gradient(145deg, rgba(255, 255, 255, 0.55) 0%, rgba(201, 204, 209, 0.35) 100%);
            backdrop-filter: blur(22px) saturate(200%);
            -webkit-backdrop-filter: blur(22px) saturate(200%);
            border-radius: 36px;
            border: 1px solid rgba(255, 255, 255, 0.9);
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.95), inset 0 -1px 0 rgba(141, 144, 150, 0.2);
            padding: 16px 20px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            z-index: 10;
            transition: all 0.3s ease;
        }

            /* small yellow top accent on the glass box */
            .menu-details::before {
                content: '';
                position: absolute;
                top: 0;
                left: 50%;
                transform: translateX(-50%);
                width: 60px;
                height: 3px;
                border-radius: 0 0 6px 6px;
                background: linear-gradient(90deg, transparent, var(--yellow), transparent);
            }

        .menu-card:hover .menu-details {
            background: linear-gradient(145deg, rgba(255, 255, 255, 0.75) 0%, rgba(201, 204, 209, 0.5) 100%);
            backdrop-filter: blur(26px) saturate(220%);
            box-shadow: 0 26px 55px rgba(0, 0, 0, 0.33), inset 0 1px 0 rgba(255, 255, 255, 1);
        }

        .menu-item-title {
            font-size: 1.3rem;
            color: var(--black);
            font-weight: 800;
            margin-bottom: 4px;
            letter-spacing: -0.2px;
        }

        .menu-item-desc {
            color: #2b2b2b;
            font-size: 0.85rem;
            font-weight: 400;
            margin-bottom: 6px;
            opacity: 0.88;
            line-height: 1.4;
            max-width: 90%;
        }

        .menu-item-price {
            font-size: 1rem;
            font-weight: 800;
            color: var(--black);
            background: linear-gradient(135deg, var(--yellow) 0%, var(--yellow-soft) 100%);
            padding: 4px 16px;
            border-radius: 40px;
            border: 1px solid rgba(17, 17, 17, 0.35);
            box-shadow: 0 4px 12px rgba(255, 212, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.7);
            margin-top: 5px;
        }

        /* ---------- FOOTER (black + yellow) ---------- */
        footer {
            text-align: center;
            padding: 30px 20px;
            margin: 30px 20px 10px 20px;
            background: linear-gradient(145deg, var(--black-soft) 0%, var(--black) 100%);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-radius: 48px;
            border: 1px solid rgba(201, 204, 209, 0.35);
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(201, 204, 209, 0.25);
            color: var(--silver-light);
            font-weight: 500;
        }

            footer a {
                color: var(--yellow);
                font-weight: 700;
                transition: color 0.25s ease;
            }

                footer a:hover {
                    color: var(--yellow-soft);
                }

            footer img {
                filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.5)) brightness(0) saturate(100%) invert(82%) sepia(85%) saturate(1200%) hue-rotate(1deg) brightness(105%) contrast(105%);
                vertical-align: middle;
            }

        /* ---------- SCROLL TO TOP (yellow glass) ---------- */
        #scrollToTop {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: linear-gradient(135deg, var(--yellow), var(--yellow-deep));
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(17, 17, 17, 0.6);
            padding: 16px;
            border-radius: 50%;
            cursor: pointer;
            z-index: 1001;
            display: none;
            box-shadow: 0 10px 30px rgba(255, 212, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.6);
            transition: all 0.3s ease;
            width: 65px;
            height: 65px;
            align-items: center;
            justify-content: center;
        }

            #scrollToTop:hover {
                transform: scale(1.1);
                box-shadow: 0 14px 38px rgba(255, 212, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.8);
            }

        /* ---------- RESPONSIVE ---------- */
        @media (max-width: 700px) {
            .menu-details

        {
            width: 88%;
            padding: 12px 14px;
            bottom: -45px;
        }

        .menu-item-title {
            font-size: 1.05rem;
        }

        .menu-item-desc {
            font-size: 0.75rem;
        }

        .menu-item-price {
            font-size: 0.85rem;
            padding: 3px 10px;
        }

        .menu-card img {
            width: 95%;
        }

        .category-slider {
            margin: 0 8px 20px 8px;
            padding: 12px 0;
        }

        .category-tag {
            padding: 10px 18px;
            font-size: 0.85rem;
        }

        .hero-overlay h1 {
            font-size: 2.2em;
        }

        #menu {
            margin: 0 8px;
            border-radius: 40px;
        }

        .menu-card {
            margin-bottom: 70px;
        }

        }

        @media (max-width: 480px) {
            .menu-details

        {
            width: 92%;
            bottom: -40px;
            padding: 10px 12px;
        }

        .menu-item-desc {
            font-size: 0.7rem;
        }

        .menu-item-title {
            font-size: 0.95rem;
        }

        }

        /* glass scrollbar with yellow thumb */
        .category-slider::-webkit-scrollbar {
            height: 6px;
        }

        .category-slider::-webkit-scrollbar-track {
            background: rgba(201, 204, 209, 0.25);
            border-radius: 20px;
        }

        .category-slider::-webkit-scrollbar-thumb {
            background: linear-gradient(90deg, var(--yellow), var(--yellow-deep));
            border-radius: 20px;
        }
    </style>
</head>
<body>
    <!-- Hero Video Section -->
    <HeroHeader />

    <!-- Category Slider -->
    <div class="category-slider" id="categorySlider">
        <div class="category-container">
            @foreach (var cat in Categories)
            {
                <div class="category-tag" data-target="@cat.ProductCategoryId">@cat.Title</div>
            }
        </div>
    </div>

    <!-- Menu Sections -->
    <div id="menu">
        @foreach (var cat in Categories)
        {
            <section id="@cat.ProductCategoryId" class="menu-section">
                <div class="menu-grid">
                    @foreach (var product in Products.Where(z => z.ProductCategoryId == cat.ProductCategoryId))
                    {
                        <div class="menu-card">
                            @if (string.IsNullOrEmpty(product.Image))
                            {
                                <img src="img/coffee.jpg" alt="@product.Title">
                            }
                            else
                            {
                                <img src="@product.Image" alt="@product.Title">
                            }

                            <div class="menu-details">
                                <div class="menu-item-title">@product.Title</div>
                                <div class="menu-item-desc">@product.Description</div>
                                <div class="menu-item-price">تجاری : @product.EcoPrice تومان</div>
                                @if (product.BusinessPrice != null)
                                {
                                    <div class="menu-item-price">تخصصی : @product.BusinessPrice تومان</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
    </div>

    <!-- Footer -->
    <footer>
        <div style="text-align:right; display: flex; flex-direction: column; gap: 6px;">
            <p style="float:right; padding-right:10px; width:100%; display: flex; align-items: center; justify-content: flex-end; gap: 8px;">
                <img src="img/location.png" style="width:20px"> آدرس : بلوار فردوس شرق, خیابان ابراهیمی, کوچه پنجم
            </p>
            <a href="tel:+989126023218" style="float:right; padding:6px 10px; width:100%; display: flex; align-items: center; justify-content: flex-end; gap: 8px;">
                <img src="img/phonecall.png" style="width:20px"> 09126023218
            </a>
            <p style="float:right; padding:6px 10px; width:100%; display: flex; align-items: center; justify-content: flex-end; gap: 8px;">
                <img src="img/clock.png" style="width:20px"> 6 صبح الی 24
            </p>
        </div>
        <div style="text-align:left; margin-top: 16px; opacity: 0.85; font-size: 0.9em; color: var(--silver);">
            &copy; ۲۰۲۵ قهوه لومِن. کلیه حقوق محفوظ است.
        </div>
    </footer>

    <!-- Scroll-to-Top Button -->
    <button id="scrollToTop">
        <img src="img/up.png" style="width:25px; filter: brightness(0) saturate(100%) invert(0%);">
    </button>

    @code {
        public List<ProductCategory> Categories { get; set; } = new();
        public List<Product> Products { get; set; } = new();
        private bool _dataLoaded;

        protected override async Task OnAfterRenderAsync(bool firstRender)
        {
            _dataLoaded = true;
            for (int i = 0; i < 20; i++)
            {
                var exists = await JS.InvokeAsync<bool>("eval", "typeof window.lumenMenu !== 'undefined'");
                if (exists) break;
                await Task.Delay(50);
            }
            await JS.InvokeVoidAsync("lumenMenu.init");
        }

        protected override async Task OnInitializedAsync()
        {
            Products = ProductService.GetAll(null, true);
            Categories = CategoryService.GetAll(0, 0, null);
        }
    }
</body>
</html>