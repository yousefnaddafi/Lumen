@page "/admin/products"
@using Lumen.Components.Pages.Dialogs
@using Lumen.Models
@using MudBlazor
@using Microsoft.JSInterop
@using Lumen.Services.ProductCatgoryServices
@using Lumen.Services.ProductServices
@rendermode InteractiveServer
@layout Components.Layout.AdminLayout
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IProductService ProductService
@inject IProductCategoryService CategoryService
<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<PageTitle>محصولات - پنل قهوه</PageTitle>

<PageTitle>محصولات - پنل قهوه</PageTitle>

<div style="width: 100%;">
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
        <div>
            <h3 style="margin: 0; background: linear-gradient(135deg, #FFD700, #FFB800); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-size: 28px; font-weight: 700;">
                ☕ محصولات
            </h3>
            <p style="color: rgba(255,255,255,0.4); margin: 4px 0 0 0; font-size: 14px;">مدیریت محصولات قهوه</p>
        </div>
        <MudButton Class="glass-btn" Style="cursor: pointer;" OnClick="@(async () => await OpenDialog(null))">
            + افزودن محصول جدید
        </MudButton>
    </div>

    <!-- Search -->
    <div style="display: flex; gap: 12px; margin-bottom: 24px; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 200px;">
            <input @bind="searchString"
                   @bind:event="oninput"
                   placeholder="جستجوی محصولات..."
                   style="width: 100%; max-width: 300px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,215,0,0.12); border-radius: 12px; color: #fff; padding: 12px 16px; font-family: 'Vazirmatn', sans-serif; outline: none; transition: all 0.3s ease;"
                   @onfocus="() => { }"
                   @onblur="() => { }" />
        </div>
    </div>

    <!-- Mobile Grid -->
    @if (isMobile)
    {
        <div style="display: grid; grid-template-columns: 1fr; gap: 16px;">
            @foreach (var product in filteredProducts)
            {
                <div style="background: rgba(255,255,255,0.05); backdrop-filter: blur(12px); border: 1px solid rgba(255,215,0,0.08); border-radius: 16px; padding: 16px; transition: all 0.3s ease;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                        <div style="font-size: 32px; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: rgba(255,215,0,0.06); border-radius: 12px;">☕</div>
                        <div style="display: flex; gap: 4px;">
                            <button class="mud-icon-button" @onclick="() => OpenDialog(product)" style="background: none; border: none; color: var(--yellow-primary); cursor: pointer; padding: 8px; border-radius: 8px;">
                                <svg style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                            </button>
                            <button class="mud-icon-button" @onclick="() => DeleteProduct(product)" style="background: none; border: none; color: #f44336; cursor: pointer; padding: 8px; border-radius: 8px;">
                                <svg style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            </button>
                        </div>
                    </div>
                    <h4 style="color: #fff; margin: 8px 0; font-size: 18px; font-weight: 600; text-align: right;">@product.Title</h4>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin: 8px 0;">
                        <span style="color: rgba(255,255,255,0.4); font-size: 14px;">📂 @product.CategoryName</span>
                        <span class="@(product.IsAvailable ? "status-available" : "status-unavailable")">
                            @(product.IsAvailable ? "✓ موجود" : "✗ ناموجود")
                        </span>
                    </div>
                    <div style="display: flex; gap: 12px; margin: 8px 0; justify-content: flex-end;">
                        <span style="color: var(--yellow-primary); font-weight: 600; font-size: 16px;">@product.EcoPrice.ToString("N0") تومان</span>
                        @if (product.BusinessPrice.HasValue)
                        {
                            <span style="color: rgba(255,255,255,0.3); font-size: 14px; text-decoration: line-through;">@product.BusinessPrice.Value.ToString("N0") تومان</span>
                        }
                    </div>
                    <div style="margin-top: 8px; color: rgba(255,255,255,0.2); font-size: 12px; text-align: left;">@product.CreateDate.ToString("yyyy/MM/dd")</div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Desktop Table -->
        <div style="background: rgba(255,255,255,0.02); backdrop-filter: blur(10px); border-radius: 16px; border: 1px solid rgba(255,255,255,0.03); overflow: hidden; overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; min-width: 800px;">
                <thead style="background: rgba(255,215,0,0.05);">
                    <tr>
                        <th style="color: var(--yellow-primary); font-weight: 600; padding: 16px; text-align: right; border-bottom: 2px solid rgba(255,215,0,0.08);">تصویر</th>
                        <th style="color: var(--yellow-primary); font-weight: 600; padding: 16px; text-align: right; border-bottom: 2px solid rgba(255,215,0,0.08);">عنوان</th>
                        <th style="color: var(--yellow-primary); font-weight: 600; padding: 16px; text-align: right; border-bottom: 2px solid rgba(255,215,0,0.08);">دسته‌بندی</th>
                        <th style="color: var(--yellow-primary); font-weight: 600; padding: 16px; text-align: right; border-bottom: 2px solid rgba(255,215,0,0.08);">وضعیت</th>
                        <th style="color: var(--yellow-primary); font-weight: 600; padding: 16px; text-align: right; border-bottom: 2px solid rgba(255,215,0,0.08);">قیمت اقتصادی</th>
                        <th style="color: var(--yellow-primary); font-weight: 600; padding: 16px; text-align: right; border-bottom: 2px solid rgba(255,215,0,0.08);">قیمت تجاری</th>
                        <th style="color: var(--yellow-primary); font-weight: 600; padding: 16px; text-align: right; border-bottom: 2px solid rgba(255,215,0,0.08);">تاریخ ایجاد</th>
                        <th style="color: var(--yellow-primary); font-weight: 600; padding: 16px; text-align: right; border-bottom: 2px solid rgba(255,215,0,0.08);">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in filteredProducts)
                    {
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.03); transition: all 0.3s ease;">
                            <td style="padding: 16px; color: rgba(255,255,255,0.85);">
                                <div style="width: 40px; height: 40px; border-radius: 8px; background: rgba(255,215,0,0.06); display: flex; align-items: center; justify-content: center; font-size: 20px;"><MudImage Style="" Width="100" Height=100 Src="@product.Image"></MudImage></div>
                            </td>
                            <td style="padding: 16px; color: rgba(255,255,255,0.85); font-weight: 500;">@product.Title</td>
                            <td style="padding: 16px; color: rgba(255,255,255,0.6);">@product.CategoryName</td>
                            <td style="padding: 16px; color: rgba(255,255,255,0.85);">
                                <span class="@(product.IsAvailable ? "status-available" : "status-unavailable")">
                                    @(product.IsAvailable ? "موجود" : "ناموجود")
                                </span>
                            </td>
                            <td style="padding: 16px; color: var(--yellow-primary); font-weight: 500;">@product.EcoPrice.ToString("N0") تومان</td>
                            <td style="padding: 16px; color: rgba(255,255,255,0.5);">@(product.BusinessPrice?.ToString("N0") ?? "—")</td>
                            <td style="padding: 16px; color: rgba(255,255,255,0.3); font-size: 0.85rem;">@product.CreateDate.ToString("yyyy/MM/dd")</td>
                            <td style="padding: 16px; color: rgba(255,255,255,0.85);">
                                <button class="mud-icon-button" @onclick="() => OpenDialog(product)" style="background: none; border: none; color: var(--yellow-primary); cursor: pointer; padding: 8px; border-radius: 8px;">
                                    <svg style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                </button>
                                <button class="mud-icon-button" @onclick="() => DeleteProduct(product)" style="background: none; border: none; color: #f44336; cursor: pointer; padding: 8px; border-radius: 8px;">
                                    <svg style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Product> products = new();
    private List<ProductCategory> categories = new();
    private string searchString = "";
    private int currentPage = 1;
    private bool isMobile = false;

    protected override async Task OnInitializedAsync()
    {
        await CheckScreenSize();
        await LoadData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckScreenSize();
            StateHasChanged();
        }
    }

    private async Task CheckScreenSize()
    {
        try
        {
            var width = await JSRuntime.InvokeAsync<int>("window.innerWidth");
            isMobile = width <= 768;
        }
        catch
        {
            isMobile = false;
        }
    }

    private async Task LoadData()
    {
        try
        {
            products =  ProductService.GetAll(null,null);
            categories =  CategoryService.GetAll(0,0,null);
        }
        catch (Exception ex)
        {
            Snackbar.Add("خطا در بارگذاری داده‌ها: " + ex.Message, Severity.Error);
        }
    }

    private List<Product> filteredProducts => string.IsNullOrEmpty(searchString)
        ? products
        : products.Where(p => p.Title.Contains(searchString, StringComparison.OrdinalIgnoreCase)).ToList();



    private async Task OpenDialog(Product? currentItem)
    {
        try
        {
            var parameters = new DialogParameters
            {
                ["Product"] = currentItem ?? new Product { CreateDate = DateTime.Now },
                ["Categories"] = categories,
                ["IsEdit"] = currentItem != null,
                ["IsMobile"] = isMobile
            };

            var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                CloseOnEscapeKey = true,
                Position = DialogPosition.Center,
                BackdropClick = false
            };

            var dialog = await DialogService.ShowAsync<ProductDialog>("", parameters, options);
            var result = await dialog.Result;

            if (!result.Canceled && result.Data != null)
            {
                var prod = (Product)result.Data;
                if(prod.ProductId != 0)
                {
                    await ProductService.Update(prod);
                }
                else
                {
                    await ProductService.Create(prod);
                }
                
                await LoadData();
                Snackbar.Add(
                    currentItem == null ? "محصول با موفقیت ایجاد شد!" : "محصول با موفقیت بروزرسانی شد!",
                    Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("خطا: " + ex.Message, Severity.Error);
        }
    }

    private async Task DeleteProduct(Product product)
    {
        try
        {
            bool? result = await DialogService.ShowMessageBoxAsync(
                "حذف محصول",
                $"آیا از حذف '{product.Title}' مطمئن هستید؟",
                "حذف",
                "انصراف");

            if (result == true)
            {
                await ProductService.Delete(product.ProductId);
                await LoadData();
                Snackbar.Add("محصول با موفقیت حذف شد!", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("خطا در حذف محصول: " + ex.Message, Severity.Error);
        }
    }

    [Inject]
    private IJSRuntime JSRuntime { get; set; }
}