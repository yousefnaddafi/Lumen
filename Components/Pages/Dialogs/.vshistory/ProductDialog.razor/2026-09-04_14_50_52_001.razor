@using Lumen.Models
@using MudBlazor

<MudDialog Class="glass-dialog">
    <TitleContent>
        <div style="display: flex; align-items: center; gap: 12px; width: 100%;">
            <span style="font-size: 24px;">☕</span>
            <span style="color: #fff; font-weight: 600; font-size: 20px; flex: 1;">
                @(IsEdit ? "ویرایش محصول" : "محصول جدید")
            </span>
            @if (IsMobile)
            {
                <button class="mud-icon-button" @onclick="() => MudDialog.CloseAsync()" style="background: none; border: none; color: rgba(255,255,255,0.6); cursor: pointer; padding: 8px; border-radius: 8px;">
                    <svg style="width: 24px; height: 24px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            }
        </div>
    </TitleContent>
    <DialogContent>
        <div style="display: grid; grid-template-columns: 1fr; gap: 16px;">
            <div>
                <label style="color: rgba(255,255,255,0.5); font-size: 14px; display: block; margin-bottom: 6px;">عنوان *</label>
                <input @bind="Product.Title" placeholder="عنوان محصول" style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,215,0,0.12); border-radius: 12px; color: #fff; padding: 12px 16px; font-family: 'Vazirmatn', sans-serif; outline: none; transition: all 0.3s ease; font-size: 15px;" />
            </div>

            <div>
                <label style="color: rgba(255,255,255,0.5); font-size: 14px; display: block; margin-bottom: 6px;">دسته‌بندی *</label>
                <select @bind="Product.ProductCategoryId" style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,215,0,0.12); border-radius: 12px; color: #fff; padding: 12px 16px; font-family: 'Vazirmatn', sans-serif; outline: none; transition: all 0.3s ease; font-size: 15px; cursor: pointer;">
                    <option value="" style="background: #1a1a1a;">انتخاب دسته‌بندی</option>
                    @foreach (var category in Categories)
                    {
                        <option value="@category.ProductCategoryId" style="background: #1a1a1a;">@category.Title</option>
                    }
                </select>
            </div>

            <div style="display: flex; align-items: center; gap: 12px;">
                <label style="color: rgba(255,255,255,0.5); font-size: 14px; display: flex; align-items: center; gap: 8px; cursor: pointer;">
                    <input type="checkbox" @bind="Product.IsAvailable" style="width: 20px; height: 20px; accent-color: #FFD700; cursor: pointer;" />
                    موجود
                </label>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div>
                    <label style="color: rgba(255,255,255,0.5); font-size: 14px; display: block; margin-bottom: 6px;">قیمت اقتصادی (تومان) *</label>
                    <input type="number" @bind="Product.EcoPrice" placeholder="۰" style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,215,0,0.12); border-radius: 12px; color: #fff; padding: 12px 16px; font-family: 'Vazirmatn', sans-serif; outline: none; transition: all 0.3s ease; font-size: 15px;" />
                </div>
                <div>
                    <label style="color: rgba(255,255,255,0.5); font-size: 14px; display: block; margin-bottom: 6px;">قیمت صنفی (تومان)</label>
                    <input type="number" @bind="Product.BusinessPrice" placeholder="اختیاری" style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,215,0,0.12); border-radius: 12px; color: #fff; padding: 12px 16px; font-family: 'Vazirmatn', sans-serif; outline: none; transition: all 0.3s ease; font-size: 15px;" />
                </div>
            </div>

            <div>
                <label style="color: rgba(255,255,255,0.5); font-size: 14px; display: block; margin-bottom: 6px;">توضیحات</label>
                <textarea @bind="Product.Description" placeholder="توضیحات محصول..." rows="3" style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,215,0,0.12); border-radius: 12px; color: #fff; padding: 12px 16px; font-family: 'Vazirmatn', sans-serif; outline: none; transition: all 0.3s ease; font-size: 15px; resize: vertical;"></textarea>
            </div>

            <div>
                <label style="color: rgba(255,255,255,0.5); font-size: 14px; display: block; margin-bottom: 6px;">آدرس تصویر</label>
                <input @bind="Product.Image" placeholder="https://example.com/image.jpg" style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,215,0,0.12); border-radius: 12px; color: #fff; padding: 12px 16px; font-family: 'Vazirmatn', sans-serif; outline: none; transition: all 0.3s ease; font-size: 15px;" />
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <div style="display: flex; gap: 8px; width: 100%; padding: 0 8px; @(IsMobile ? "flex-direction: column-reverse;" : "")">
            <button class="glass-btn-outline" @onclick="() => MudDialog.CloseAsync()" style="flex: @(IsMobile ? "1" : "0"); cursor: pointer; @(IsMobile ? "width: 100%;" : "")">
                انصراف
            </button>
            <button class="glass-btn" @onclick="() => MudDialog.CloseAsync(DialogResult.Ok(Product))" style="flex: @(IsMobile ? "1" : "0"); cursor: pointer; @(IsMobile ? "width: 100%;" : "")">
                @(IsEdit ? "بروزرسانی" : "ایجاد")
            </button>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    MudDialog? MudDialog { get; set; }

    [Parameter]
    public Product Product { get; set; } = new();

    [Parameter]
    public List<ProductCategory> Categories { get; set; } = new();

    [Parameter]
    public bool IsEdit { get; set; }

    [Parameter]
    public bool IsMobile { get; set; }

    protected override void OnInitialized()
    {
        if (Product.CreateDate == default)
        {
            Product.CreateDate = DateTime.Now;
        }
    }
}