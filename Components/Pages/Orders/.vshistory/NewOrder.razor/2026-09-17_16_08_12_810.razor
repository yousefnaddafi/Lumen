@page "/admin/orders/new"
@attribute [Authorize(Roles = "Owner,BranchManager,Cashier")]
@rendermode InteractiveServer
@layout Components.Layout.AdminLayout
@using Lumen.Models
@using Lumen.Models.Dtos
@using Lumen.Services.BranchServices
@using Lumen.Services.CustomerServices
@using Lumen.Services.OrderServices
@using Lumen.Services.ProductServices
@using MudBlazor

<PageTitle>سفارش جدید - پنل قهوه</PageTitle>

<div style="width:100%;">
    <h3 style="background: linear-gradient(135deg,#FFD700,#FFB800); -webkit-background-clip:text; -webkit-text-fill-color:transparent; font-size:28px; font-weight:700;">
        🧾 سفارش جدید
    </h3>

    <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 20px;">
        <!-- Customer panel -->
        <div style="background: rgba(255,255,255,0.05); border-radius:16px; padding:16px;">
            <MudText Typo="Typo.subtitle1" Style="color:#FFD700;">مشتری</MudText>

            <MudTextField T="string"
                          Value="phone"
                          ValueChanged="@OnPhoneChanged"
                          Label="شماره موبایل"
                          Immediate="true"
                          DebounceInterval="400" />

            @if (customer != null)
            {
                <MudAlert Severity="Severity.Success" Class="mt-2">
                    مشتری موجود: <strong>@customer.FullName</strong>
                </MudAlert>
            }
            else if (!string.IsNullOrWhiteSpace(phone) && phone.Length >= 8)
            {
                <MudAlert Severity="Severity.Info" Class="mt-2">
                    مشتری جدید — هنگام ثبت سفارش ایجاد خواهد شد
                </MudAlert>
                <MudTextField @bind-Value="customerName" Label="نام مشتری جدید" />
            }

            <MudCheckBox T="bool" @bind-Value="isBusiness" Label="مشتری تجاری" />
        </div>

        <!-- Branch + summary -->
        <div style="background: rgba(255,255,255,0.05); border-radius:16px; padding:16px;">
            <MudText Typo="Typo.subtitle1" Style="color:#FFD700;">شعبه و خلاصه</MudText>

            <MudSelect T="long" @bind-Value="branchId" Label="شعبه">
                @foreach (var b in branches)
                {
                    <MudSelectItem T="long" Value="@b.BranchId">@b.Title</MudSelectItem>
                }
            </MudSelect>

            <div style="margin-top:16px; color: #fff;">
                <div>جمع اقلام: @subTotal.ToString("N0") تومان</div>
                <div>جمع کل: <strong style="color:#FFD700;">@total.ToString("N0") تومان</strong></div>
            </div>

            <MudButton Color="Color.Warning" Variant="Variant.Filled" FullWidth="true"
                       Class="mt-3" OnClick="Submit" Disabled="saving">
                ثبت سفارش
            </MudButton>
        </div>
    </div>

    <!-- Product picker -->
    <div style="margin-top:24px;">
        <MudText Typo="Typo.subtitle1" Style="color:#FFD700;">محصولات</MudText>
        <MudGrid>
            @foreach (var p in products)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <div style="background: rgba(255,255,255,0.05); border-radius:12px; padding:12px; display:flex; flex-direction:column; gap:6px;">
                        <div style="color:#fff;">@p.Title</div>
                        <div style="color: rgba(255,255,255,0.5); font-size:12px;">@p.CategoryName</div>
                        <div style="color:#FFD700;">@p.EcoPrice.ToString("N0") تومان</div>
                        <MudButton Size="Size.Small" Color="Color.Primary" OnClick="@(() => AddLine(p))">افزودن</MudButton>
                    </div>
                </MudItem>
            }
        </MudGrid>
    </div>

    <!-- Cart -->
    <div style="margin-top:24px;">
        <MudText Typo="Typo.subtitle1" Style="color:#FFD700;">سبد سفارش</MudText>
        @if (cart.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-2">سبد خالی است</MudAlert>
        }
        else
        {
            <table style="width:100%; color:#fff; border-collapse: collapse;">
                <thead>
                    <tr>
                        <th style="text-align:right; padding:8px;">محصول</th>
                        <th style="text-align:right; padding:8px;">قیمت</th>
                        <th style="text-align:right; padding:8px;">تعداد</th>
                        <th style="text-align:right; padding:8px;">جمع</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in cart)
                    {
                        var line = l;
                        <tr>
                            <td style="padding:8px;">@line.ProductTitle</td>
                            <td style="padding:8px;">@line.UnitPrice.ToString("N0")</td>
                            <td style="padding:8px;">
                                <MudNumericField T="decimal" @bind-Value="line.Quantity" Min="1" Style="width:90px;" />
                            </td>
                            <td style="padding:8px;">@line.LineTotal.ToString("N0")</td>
                            <td style="padding:8px;">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                               OnClick="@(() => cart.Remove(line))" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    [Inject] private IProductService ProductService { get; set; } = default!;
    [Inject] private ICustomerService CustomerService { get; set; } = default!;
    [Inject] private IOrderService OrderService { get; set; } = default!;
    [Inject] private IBranchService BranchService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private List<Product> products = new();
    private List<Branch> branches = new();
    private List<OrderLineDto> cart = new();

    private string phone = "";
    private string customerName = "";
    private bool isBusiness;
    private Customer? customer;
    private long branchId;
    private bool saving;

    private decimal subTotal => cart.Sum(l => l.LineTotal);
    private decimal total => subTotal;

    protected override void OnInitialized()
    {
        products = ProductService.GetAll(null, true);
        branches = BranchService.GetAll();
        branchId = branches.FirstOrDefault()?.BranchId ?? 0;
    }

    private void OnPhoneChanged(string value)
    {
        phone = value ?? "";
        var p = phone.Trim();
        customer = string.IsNullOrWhiteSpace(p) ? null : CustomerService.GetByPhone(p);
        if (customer != null)
        {
            customerName = customer.FullName;
            isBusiness = customer.IsBusiness;
        }
    }

    private void AddLine(Product p)
    {
        var price = isBusiness && p.BusinessPrice.HasValue ? p.BusinessPrice.Value : p.EcoPrice;
        cart.Add(new OrderLineDto
        {
            ProductId = p.ProductId,
            ProductTitle = p.Title,
            UnitPrice = price,
            Quantity = 1
        });
    }

    private void Submit()
    {
        if (cart.Count == 0) { Snackbar.Add("سبد خالی است", Severity.Warning); return; }
        if (branchId == 0) { Snackbar.Add("شعبه را انتخاب کنید", Severity.Warning); return; }

        saving = true;
        try
        {
            var dto = new SubmitOrderDto
            {
                BranchId = branchId,
                CustomerPhone = phone?.Trim(),
                CustomerName = customerName?.Trim(),
                CustomerIsBusiness = isBusiness,
                Items = cart,
                Payments = new List<PaymentDto>
                {
                    new PaymentDto { Method = PaymentMethod.Cash, Amount = total }
                }
            };

            var (order, cust, created) = OrderService.SubmitOrder(dto);
            Snackbar.Add($"سفارش {order.OrderNumber} ثبت شد" +
                         (created ? " — مشتری جدید ایجاد شد" : ""), Severity.Success);
            Nav.NavigateTo("/admin/orders");
        }
        catch (Exception ex)
        {
            Snackbar.Add("خطا: " + ex.Message, Severity.Error);
        }
        finally
        {
            saving = false;
        }
    }
}