@page "/admin/products"
@using Lumen.Models
@using Lumen.Services.ProductCatgoryServices
@using Lumen.Services.ProductServices
@layout Components.Layout.AdminLayout
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject IProductService ProductsService
@inject IProductCategoryService CategoryService

<div class="page-header">
    <h2>🍽️ مدیریت محصولات</h2>
    <button class="btn-glass-primary" @onclick="OpenCreateModal">+ افزودن محصول جدید</button>
</div>

<div class="search-bar glass-card">
    <input type="text" @bind="searchTerm" placeholder="جستجوی محصولات..." class="glass-input" />
    <select @bind="selectedCategory" class="glass-select">
        <option value="">همه دسته‌بندی‌ها</option>
        @foreach (var cat in categories)
        {
            <option value="@cat.ProductCategoryId">@cat.Title</option>
        }
    </select>
</div>

<div class="products-grid">
    @foreach (var product in filteredProducts)
    {
        <div class="product-card glass-card">
            <div class="product-image-container">
                @if (!string.IsNullOrEmpty(product.Image))
                {
                    <img src="@product.Image" alt="@product.Title" class="product-image" />
                }
                else
                {
                    <div class="no-image">بدون تصویر</div>
                }
            </div>
            <div class="product-info">
                <h3>@product.Title</h3>
                <p class="category">@product.CategoryName</p>
                <p class="price">💰 @(product.EcoPrice.ToString("N0")) تومان</p>
                @if (product.BusinessPrice.HasValue)
                {
                    <p class="business-price">💼 قیمت ویژه: @(product.BusinessPrice.Value.ToString("N0")) تومان</p>
                }
                <div class="product-status">
                    <span class="status-badge @(product.IsAvailable ? "available" : "unavailable")">
                        @(product.IsAvailable ? "✓ موجود" : "✗ ناموجود")
                    </span>
                </div>
                <div class="product-actions">
                    <button class="btn-glass-secondary" @onclick="() => EditProduct(product)">✏️ ویرایش</button>
                    <button class="btn-glass-danger" @onclick="() => DeleteProduct(product)">🗑️ حذف</button>
                </div>
            </div>
        </div>
    }
</div>

@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content glass-card" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>@(isEditing ? "ویرایش محصول" : "افزودن محصول جدید")</h3>
                <button class="close-btn" @onclick="CloseModal">✕</button>
            </div>
            <EditForm Model="@currentProduct" OnValidSubmit="@SaveProduct">
                <div class="form-group">
                    <label>عنوان محصول *</label>
                    <InputText @bind-Value="currentProduct.Title" class="glass-input" placeholder="عنوان محصول را وارد کنید" />
                </div>

                <div class="form-group">
                    <label>دسته‌بندی *</label>
                    <InputSelect @bind-Value="currentProduct.ProductCategoryId" class="glass-select">
                        <option value="">انتخاب دسته‌بندی</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.ProductCategoryId">@cat.Title</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-group">
                    <label>قیمت (تومان) *</label>
                    <InputNumber @bind-Value="currentProduct.EcoPrice" class="glass-input" placeholder="قیمت را وارد کنید" />
                </div>

                <div class="form-group">
                    <label>قیمت ویژه (تومان)</label>
                    <InputNumber @bind-Value="currentProduct.BusinessPrice" class="glass-input" placeholder="قیمت ویژه را وارد کنید" />
                </div>

                <div class="form-group">
                    <label>توضیحات</label>
                    <InputTextArea @bind-Value="currentProduct.Description" class="glass-input" rows="3" placeholder="توضیحات محصول را وارد کنید" />
                </div>

                <div class="form-group">
                    <label>آدرس تصویر</label>
                    <InputText @bind-Value="currentProduct.Image" class="glass-input" placeholder="https://example.com/image.jpg" />
                </div>

                <div class="form-group checkbox">
                    <InputCheckbox @bind-Value="currentProduct.IsAvailable" />
                    <label>موجود در منو</label>
                </div>

                <div class="modal-actions">
                    <button type="button" class="btn-glass-secondary" @onclick="CloseModal">انصراف</button>
                    <button type="submit" class="btn-glass-primary">@(isEditing ? "به‌روزرسانی" : "افزودن")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private List<Product> products = new();
    private List<ProductCategory> categories = new();
    private string searchTerm = "";
    private long? selectedCategory = null;
    private bool showModal = false;
    private bool isEditing = false;
    private Product currentProduct = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        // In production, replace with actual API calls
        var productsResponse = ProductsService.GetAll(null,null);
        var categoriesResponse = CategoryService.GetAll(0,0,null);

        products = productsResponse ?? new List<Product>();
        categories = categoriesResponse ?? new List<ProductCategory>();
    }

    private List<Product> filteredProducts => products
        .Where(p => string.IsNullOrEmpty(searchTerm) ||
                   p.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .Where(p => !selectedCategory.HasValue || p.ProductCategoryId == selectedCategory.Value)
        .ToList();

    private async Task OpenCreateModal()
    {
        currentProduct = new Product { CreateDate = DateTime.Now, IsAvailable = true };
        isEditing = false;
        showModal = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task EditProduct(Product product)
    {
        currentProduct = product;
        isEditing = true;
        showModal = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveProduct()
    {
        if (isEditing)
        {
            await ProductsService.Update(currentProduct);
        }
        else
        {
            await ProductsService.Create(currentProduct);
        }
        await LoadData();
        CloseModal();
    }

    private async Task DeleteProduct(Product product)
    {
        if (await ConfirmDelete())
        {
            await Http.DeleteAsync($"/api/products/{product.ProductId}");
            await LoadData();
        }
    }

    private async Task<bool> ConfirmDelete()
    {
        // Implement confirmation dialog
        return true;
    }

    private async Task CloseModal()
    {
        showModal = false;
        currentProduct = new Product();
        await InvokeAsync(StateHasChanged);
    }
}