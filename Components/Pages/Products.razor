@page "/admin/products"
@attribute [Authorize(Roles = "Owner,MenuAdmin,BranchManager")]
@rendermode InteractiveServer
@layout Components.Layout.AdminLayout
@using Lumen.Components.Pages.Dialogs
@using Lumen.Models
@using Lumen.Models.Enums
@using Lumen.Services.InventoryServices
@using Lumen.Services.ProductCatgoryServices
@using Lumen.Services.ProductServices
@using MudBlazor
@using Microsoft.JSInterop
@using System.Globalization
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IProductService ProductService
@inject IProductCategoryService CategoryService
@inject IInventoryService InventoryService
<MudDialogProvider/>
<PageTitle>محصولات - پنل قهوه</PageTitle>

<div style="width: 100%;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
        <div>
            <h3 style="margin: 0; background: linear-gradient(135deg, #FFD700, #FFB800); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-size: 28px; font-weight: 700;">
                ☕ محصولات و اقلام
            </h3>
            <p style="color: rgba(255,255,255,0.4); margin: 4px 0 0 0; font-size: 14px;">مدیریت محصولات منو، مواد اولیه و بسته‌بندی</p>
        </div>
        <MudButton Class="glass-btn" OnClick="@(async () => await OpenDialog(null))">
            + افزودن آیتم جدید
        </MudButton>
    </div>

    <div style="display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; align-items: center;">
        <MudSelect T="ProductKind?" @bind-Value="kindFilter" @bind-Value:after="ApplyFilter"
                   Label="نمایش" Variant="Variant.Outlined" Style="min-width:200px;">
            <MudSelectItem T="ProductKind?" Value="(ProductKind?)null">همه</MudSelectItem>
            <MudSelectItem T="ProductKind?" Value="ProductKind.MenuItem">محصولات منو</MudSelectItem>
            <MudSelectItem T="ProductKind?" Value="ProductKind.RawMaterial">مواد اولیه</MudSelectItem>
            <MudSelectItem T="ProductKind?" Value="ProductKind.Packaging">بسته‌بندی</MudSelectItem>
            <MudSelectItem T="ProductKind?" Value="ProductKind.Supply">مصرفی</MudSelectItem>
            <MudSelectItem T="ProductKind?" Value="ProductKind.Other">سایر</MudSelectItem>
        </MudSelect>

        <input @bind="searchString" @bind:event="oninput"
               placeholder="جستجوی عنوان..."
               style="flex:1; min-width:220px; background: rgba(255,255,255,0.05); border:1px solid rgba(255,215,0,0.12); border-radius:12px; color:#fff; padding:12px 16px; outline:none;" />
    </div>

    @if (filteredProducts.Count == 0)
    {
        <MudAlert Severity="Severity.Info">آیتمی یافت نشد.</MudAlert>
    }
    else if (isMobile)
    {
        <div style="display:grid; grid-template-columns: 1fr; gap:16px;">
            @foreach (var product in filteredProducts)
            {
                var p = product;
                <div style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,215,0,0.08); border-radius: 16px; padding: 16px;">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                        <span class="kind-chip kind-@p.Kind.ToString().ToLower()">@KindLabel(p.Kind)</span>
                        <div style="display:flex; gap:4px;">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small"
                                           OnClick="@(() => OpenDialog(p))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => DeleteProduct(p))" />
                        </div>
                    </div>
                    <h4 style="color:#fff; margin:8px 0; font-size:18px; font-weight:600; text-align:right;">
                        @p.Title
                        @if (!string.IsNullOrEmpty(p.Unit))
                        {
                            <span style="color:rgba(255,255,255,0.4); font-size:13px; font-weight:400;">(@p.Unit)</span>
                        }
                    </h4>
                    <div style="display:flex; justify-content:space-between; align-items:center; margin:8px 0;">
                        <span style="color:rgba(255,255,255,0.4); font-size:14px;">📂 @p.CategoryName</span>
                        @if (p.Kind == ProductKind.MenuItem)
                        {
                            <span class="@(p.IsAvailable ? "status-available" : "status-unavailable")">
                                @(p.IsAvailable ? "✓ موجود" : "✗ ناموجود")
                            </span>
                        }
                    </div>
                    @if (p.Kind == ProductKind.MenuItem)
                    {
                        <div style="display:flex; gap:12px; margin:8px 0; justify-content:flex-end;">
                            <span style="color:var(--yellow-primary); font-weight:600;">@p.EcoPrice.ToString("N0") تومان</span>
                            @if (p.BusinessPrice.HasValue)
                            {
                                <span style="color:rgba(255,255,255,0.3); font-size:13px;">تجاری @p.BusinessPrice.Value.ToString("N0")</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div style="display:flex; justify-content:space-between; color:rgba(255,255,255,0.6); font-size:13px;">
                            <span>بهای واحد: @p.CurrentUnitCost.ToString("N0")</span>
                            <span>موجودی کل: @GetTotalStock(p.ProductId).ToString("N0")</span>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div style="background: rgba(255,255,255,0.02); border-radius:16px; border:1px solid rgba(255,255,255,0.03); overflow-x:auto;">
            <table style="width:100%; border-collapse:collapse; min-width:1000px;">
                <thead style="background: rgba(255,215,0,0.05);">
                    <tr>
                        <th style="color:#FFD700; padding:14px; text-align:right;">تصویر</th>
                        <th style="color:#FFD700; padding:14px; text-align:right;">عنوان</th>
                        <th style="color:#FFD700; padding:14px; text-align:right;">نوع</th>
                        <th style="color:#FFD700; padding:14px; text-align:right;">دسته</th>
                        <th style="color:#FFD700; padding:14px; text-align:right;">قیمت اقتصادی</th>
                        <th style="color:#FFD700; padding:14px; text-align:right;">بهای واحد</th>
                        <th style="color:#FFD700; padding:14px; text-align:right;">موجودی</th>
                        <th style="color:#FFD700; padding:14px; text-align:right;">وضعیت</th>
                        <th style="color:#FFD700; padding:14px; text-align:right;">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in filteredProducts)
                    {
                        var p = product;
                        <tr style="border-bottom:1px solid rgba(255,255,255,0.03);">
                            <td style="padding:14px;">
                                <div style="width:40px; height:40px; border-radius:8px; background:rgba(255,215,0,0.06); display:flex; align-items:center; justify-content:center; font-size:20px;">
                                    @if (!string.IsNullOrEmpty(p.Image))
                                    {
                                        <MudImage Width="40" Height="40" Src="@p.Image" Style="border-radius:8px;" />
                                    }
                                    else
                                    {
                                        <span>☕</span>
                                    }
                                </div>
                            </td>
                            <td style="padding:14px; color:rgba(255,255,255,0.9); font-weight:500;">
                                @p.Title
                                @if (!string.IsNullOrEmpty(p.Unit))
                                {
                                    <span style="color:rgba(255,255,255,0.4); font-size:12px; margin-inline-start:6px;">(@p.Unit)</span>
                                }
                            </td>
                            <td style="padding:14px;">
                                <span class="kind-chip kind-@p.Kind.ToString().ToLower()">@KindLabel(p.Kind)</span>
                            </td>
                            <td style="padding:14px; color:rgba(255,255,255,0.6);">@p.CategoryName</td>
                            <td style="padding:14px;">
                                @if (p.Kind == ProductKind.MenuItem)
                                {
                                    <span style="color:var(--yellow-primary); font-weight:500;">@p.EcoPrice.ToString("N0")</span>
                                }
                                else
                                {
                                    <span style="color:rgba(255,255,255,0.3);">—</span>
                                }
                            </td>
                            <td style="padding:14px; color:rgba(255,255,255,0.6);">@p.CurrentUnitCost.ToString("N0")</td>
                            <td style="padding:14px;">
                                @{
                                    var totalStock = GetTotalStock(p.ProductId);
                                    var low = IsLowStock(p.ProductId);
                                }
                                @if (!p.TracksInventory)
                                {
                                    <span style="color:rgba(255,255,255,0.3); font-size:12px;">بدون ردیابی</span>
                                }
                                else if (low)
                                {
                                    <span style="display:inline-flex; align-items:center; gap:6px; color:#FFB800; font-weight:600;">
                                        <span style="width:8px; height:8px; border-radius:50%; background:#FFB800;"></span>
                                        @totalStock.ToString("N0")
                                    </span>
                                }
                                else
                                {
                                    <span style="color:rgba(255,255,255,0.7);">@totalStock.ToString("N0")</span>
                                }
                            </td>
                            <td style="padding:14px;">
                                @if (p.Kind == ProductKind.MenuItem)
                                {
                                    <span class="@(p.IsAvailable ? "status-available" : "status-unavailable")">
                                        @(p.IsAvailable ? "موجود" : "ناموجود")
                                    </span>
                                }
                                else
                                {
                                    <span style="color:rgba(255,255,255,0.4); font-size:12px;">—</span>
                                }
                            </td>
                            <td style="padding:14px;">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small"
                                               OnClick="@(() => OpenDialog(p))" Title="ویرایش" />
                                <MudIconButton Icon="@Icons.Material.Filled.Science" Color="Color.Info" Size="Size.Small"
                                               OnClick="@(() => Nav.NavigateTo($"/admin/recipes?productId={p.ProductId}"))"
                                               Title="رسپی" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                               OnClick="@(() => DeleteProduct(p))" Title="حذف" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .kind-chip {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
        border: 1px solid;
    }

    .kind-menuitem {
        color: #FFD700;
        border-color: rgba(255,215,0,0.3);
        background: rgba(255,215,0,0.08);
    }

    .kind-rawmaterial {
        color: #4fc3f7;
        border-color: rgba(79,195,247,0.3);
        background: rgba(79,195,247,0.08);
    }

    .kind-packaging {
        color: #FFB800;
        border-color: rgba(255,184,0,0.3);
        background: rgba(255,184,0,0.08);
    }

    .kind-supply {
        color: #b0bec5;
        border-color: rgba(176,190,197,0.3);
        background: rgba(176,190,197,0.08);
    }

    .kind-other {
        color: #aaa;
        border-color: rgba(170,170,170,0.3);
        background: rgba(170,170,170,0.08);
    }
</style>

@code {
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    private CultureInfo culture = new("fa-IR");
    private List<Product> products = new();
    private List<ProductCategory> categories = new();
    private string searchString = "";
    private ProductKind? kindFilter;
    private bool isMobile;
    private Dictionary<long, decimal> stockByProduct = new();
    private HashSet<long> lowStockProductIds = new();

    private List<Product> filteredProducts =>
        products
            .Where(p => kindFilter == null || p.Kind == kindFilter)
            .Where(p => string.IsNullOrWhiteSpace(searchString) ||
                        p.Title.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await CheckScreenSize();
        await LoadData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckScreenSize();
            StateHasChanged();
        }
    }

    private async Task CheckScreenSize()
    {
        try
        {
            var width = await JSRuntime.InvokeAsync<int>("window.innerWidth");
            isMobile = width <= 768;
        }
        catch { isMobile = false; }
    }

    private async Task LoadData()
    {
        try
        {
            products = ProductService.GetAll(null, null);
            categories = CategoryService.GetAll(0, 0, null);

            // Build stock lookup
            var all = InventoryService.GetInventory(null, null, false);
            stockByProduct = all
                .GroupBy(r => r.ProductId)
                .ToDictionary(g => g.Key, g => g.Sum(x => x.QuantityOnHand));

            lowStockProductIds = all
                .Where(r => r.IsLow || r.IsOut)
                .Select(r => r.ProductId)
                .Distinct()
                .ToHashSet();
        }
        catch (Exception ex)
        {
            Snackbar.Add("خطا در بارگذاری داده‌ها: " + ex.Message, Severity.Error);
        }
        await Task.CompletedTask;
    }

    private void ApplyFilter() => StateHasChanged();

    private decimal GetTotalStock(long productId) =>
        stockByProduct.TryGetValue(productId, out var v) ? v : 0;

    private bool IsLowStock(long productId) =>
        lowStockProductIds.Contains(productId);

    private async Task OpenDialog(Product? currentItem)
    {
        try
        {
            var parameters = new DialogParameters
            {
                ["Product"] = currentItem ?? new Product { CreateDate = DateTime.Now, Kind = ProductKind.MenuItem },
                ["Categories"] = categories,
                ["IsEdit"] = currentItem != null,
                ["IsMobile"] = isMobile
            };
            var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = true };

            var dialog = await DialogService.ShowAsync<ProductDialog>("", parameters, options);
            var result = await dialog.Result;

            if (!result.Canceled && result.Data is Product prod)
            {
                if (prod.ProductId != 0)
                    await ProductService.Update(prod);
                else
                    await ProductService.Create(prod);

                await LoadData();
                Snackbar.Add(currentItem == null ? "آیتم ایجاد شد" : "آیتم بروزرسانی شد", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("خطا: " + ex.Message, Severity.Error);
        }
    }

    private async Task DeleteProduct(Product product)
    {
        try
        {
            var result = await DialogService.ShowMessageBoxAsync(
                "حذف آیتم",
                $"حذف «{product.Title}»؟",
                "حذف", "انصراف");

            if (result == true)
            {
                await ProductService.Delete(product.ProductId);
                await LoadData();
                Snackbar.Add("حذف شد", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("خطا در حذف: " + ex.Message, Severity.Error);
        }
    }

    private static string KindLabel(ProductKind kind) => kind switch
    {
        ProductKind.MenuItem => "منو",
        ProductKind.RawMaterial => "مواد اولیه",
        ProductKind.Packaging => "بسته‌بندی",
        ProductKind.Supply => "مصرفی",
        _ => "سایر"
    };
}